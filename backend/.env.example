# Copy to .env and fill in.
PORT=8787

# Claude API key for folder suggestions (https://platform.claude.com). Without it,
# /v1/suggest returns no suggestion and the app falls back to last-used / Unsorted.
ANTHROPIC_API_KEY=
# Optional. Default is claude-haiku-5-5 with thinking off, for speed.
# claude-opus-5-5 judges odd posts better but takes 2-3 seconds longer.
SUGGEST_MODEL=

# Meta app access token for Instagram oEmbed, in the form APP_ID|APP_SECRET
# (or APP_ID|CLIENT_TOKEN). Without it Instagram previews use Open Graph tags only.
META_APP_TOKEN=

# Optional shared secret. If set, the app must send it (build with
# --dart-define=STASH_APP_KEY=...). It ships inside the app binary, so treat it
# as abuse friction, not as real authentication.
APP_KEY=

# Set to 1 when running behind a hosting provider's proxy (Render, Fly, Railway…)
# so rate limiting sees the real client address.
TRUST_PROXY=
